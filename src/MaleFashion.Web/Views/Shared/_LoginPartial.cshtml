@using MaleFashion.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


@if (SignInManager.IsSignedIn(User))
{
    <a class="nav-link " asp-area="Admin" asp-controller="Manage" asp-action="Index" title="Manage">Hello @User.Identity?.Name!</a>

    <form class="form-inline" asp-area="" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="nav-link btn btn-link">Logout</button>
    </form>
}
else
{
    <a class="nav-link " asp-area="" asp-controller="Account" asp-action="Register">Sign Up</a>
    <a class="nav-link " asp-area="" asp-controller="Account" asp-action="Login">Sign In</a>   
}


