@model CustomerUpdateModel

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- Basic Layout -->
    <div class="row">
        <div class="col-xl">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Edit Customer</h5>
                    <small class="text-muted float-end">(change)</small>
                </div>
                <div class="card-body">
                    <partial name="_ResponsePartial" />
                    <form asp-area="Admin" asp-controller="Customers" asp-action="Update" asp-antiforgery="true"
                          enctype="multipart/form-data" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-4">
                            <label class="form-label" asp-for="FirstName">First Name</label>
                            <input type="text" class="form-control" asp-for="FirstName" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label" asp-for="LastName">Last Name</label>
                            <input type="text" class="form-control" asp-for="LastName" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label" asp-for="Email">Email</label>
                            <input type="email" class="form-control" asp-for="Email" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label" asp-for="PhoneNumber">Phone Number</label>
                            <input type="text" class="form-control" asp-for="PhoneNumber" />
                        </div>                      

                        <button type="submit" class="btn btn-primary">Send</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>