@model CategoryUpdateModel

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- Basic Layout -->
    <div class="row">
        <div class="col-xl">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Edit Category</h5>
                    <small class="text-muted float-end">(change)</small>
                </div>
                <div class="card-body">
                    <partial name="_ResponsePartial" />
                    <form asp-area="Admin" asp-controller="Categories" asp-action="Update" asp-antiforgery="true"
                          enctype="multipart/form-data" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-4">
                            <label class="form-label" asp-for="Name">Name</label>
                            <input type="text" class="form-control" asp-for="Name" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label" asp-for="Description">Description</label>
                            <input type="text" class="form-control" asp-for="Description" />
                        </div>
                        <div class="mb-4">
                            <label asp-for="Image" class="form-label">Picture</label>
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div calss="mb-3">
                                    <img src="/uploads/images/@Model.ImageUrl" alt="Current Image"
                                         class="img-thumbnail" style="width:100px; height:100px; object-fit:cover;" />
                                </div>
                            }
                            <input asp-for="Image" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                            <small class="text-muted">Allowed: JPG, JPEG, PNG, WEBP.</small><br />
                            <span asp-validation-for="Image" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Send</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>