@model ProductCreateModel


<div class="container-xxl flex-grow-1 container-p-y">

    <div class="row">
        <div class="col-xl">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Create new Product</h5>
                    <small class="text-muted float-end">(new)</small>
                </div>
                <div class="card-body">
                    <partial name = "_ResponsePartial" /> 
                    <form asp-area="admin", asp-controller="Products" asp-action="create" asp-antiforgery="true">
                        <div class="mb-3">
                            <label class="form-label" asp-for="Name">Name</label>
                            <input type="text" class="form-control" asp-for="Name" placeholder="camera" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="Price">Price</label>
                            <input type="text" class="form-control" asp-for="Price" placeholder="0.00" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="Brand">Brand</label>
                            <input type="text" class="form-control" asp-for="Brand" placeholder="Write brand name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="Sku">Sku</label>
                            <input type="text" class="form-control" asp-for="Sku" placeholder="Write sku name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="Color">Color</label>
                            <input type="text" class="form-control" asp-for="Color" placeholder="Write color name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="Weight">Weight</label>
                            <input type="text" class="form-control" asp-for="Weight" placeholder="0.00" />
                        </div>
                        
                        <button type="submit" class="btn btn-primary">Send</button>
                    </form>
                </div>
            </div>
        </div>       
    </div>
</div>